LIBRARY motion_control
EXPORTS
    ; ========== 指针方式API（避免P/Invoke结构体同步问题） ==========
    MotionAxis_create
    MotionAxis_destroy
    
    ; ========== 轨迹规划函数 ==========
    TrapProfile_init
    TrapProfile_setTarget
    TrapProfile_compute
    TrapProfile_setJerkTime
    TrapProfile_getPosition
    TrapProfile_getVelocity
    TrapProfile_getAcceleration
    TrapProfile_getJerk
    TrapProfile_isDone
    TrapProfile_getTotalTime
    TrapProfile_getElapsedTime
    TrapProfile_stop
    
    ; ========== 位置缓冲区函数 ==========
    ProfileBuffer_init
    ProfileBuffer_write
    ProfileBuffer_read
    ProfileBuffer_getCount
    ProfileBuffer_getFreeSpace
    ProfileBuffer_clear
    
    ; ========== PID控制器函数 ==========
    PID_init
    PID_run
    PID_reset
    PID_setManual
    PID_setGains
    
    ; ========== 电机驱动函数 ==========
    MotorDrive_init
    MotorDrive_config
    MotorDrive_setPIDGains
    MotorDrive_setFollowingErrorLimit
    MotorDrive_enable
    MotorDrive_updateControl
    MotorDrive_updateFeedback
    MotorDrive_isError
    
    ; ========== 运动轴函数 ==========
    MotionAxis_init
    MotionAxis_addMotor
    MotionAxis_setMotionParams
    MotionAxis_setJerkTime
    MotionAxis_setPIDGains
    MotionAxis_setFollowingErrorLimit
    MotionAxis_setProfileUpdateTs
    MotionAxis_enable
    MotionAxis_disable
    MotionAxis_getState
    MotionAxis_moveAbsolute
    MotionAxis_moveRelative
    MotionAxis_stop
    MotionAxis_emergencyStop
    MotionAxis_updateProfile
    MotionAxis_updateControl
    MotionAxis_updateFeedback
    MotionAxis_isIdle
    MotionAxis_isError
    MotionAxis_getMotorCount
    MotionAxis_getAxisType
    MotionAxis_getAxisState
    MotionAxis_getCmdPosition
    MotionAxis_getActPosition
    MotionAxis_getCmdVelocity
    MotionAxis_getActVelocity
    MotionAxis_getTargetPosition
    MotionAxis_getTargetVelocity
    MotionAxis_getBufferCount
    MotionAxis_getProfileState
    
    ; ========== 电机驱动状态获取函数 ==========
    MotorDrive_getActPosition
    MotorDrive_getActVelocity
    MotorDrive_getActAcceleration
    MotorDrive_getActJerk
    MotorDrive_getPIDKp
    MotorDrive_isPIDEnabled
    MotorDrive_isEnabled
    MotorDrive_getErrorCounter
    
    ; 轨迹诊断函数
    MotionAxis_getTotalTime
    MotionAxis_getElapsedTime
    MotionAxis_getProfileUpdateTs
    MotionAxis_getBufferFreeSpace
    
    ; ========== 多轴同步函数 ==========
    AxisGroup_init
    AxisGroup_addAxis
    AxisGroup_enableSync
    AxisGroup_moveAbsolute
    AxisGroup_stop
    
    ; ========== 跟踪误差监视函数 ==========
    FollowingError_init
    FollowingError_update
    FollowingError_isTrip
    FollowingError_reset

