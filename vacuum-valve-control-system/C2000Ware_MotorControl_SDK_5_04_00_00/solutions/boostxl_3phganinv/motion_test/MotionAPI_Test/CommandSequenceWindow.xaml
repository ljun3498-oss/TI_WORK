<Window x:Class="MotionAPI_Test.CommandSequenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="命令序列配置器 - Command Sequence Configurator" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题和说明 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="命令序列配置器" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="配置最多10组运动命令，使能轴后将自动按时间顺序执行" FontSize="12" Foreground="Gray"/>
        </StackPanel>

        <!-- 命令列表 -->
        <DataGrid x:Name="dgCommands" Grid.Row="1" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  AlternatingRowBackground="LightGray" RowHeight="35">
            <DataGrid.Columns>
                <!-- 启用 -->
                <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="50"/>
                
                <!-- 时间点 -->
                <DataGridTemplateColumn Header="时间(s)" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding TimePoint, UpdateSourceTrigger=PropertyChanged}" 
                                     VerticalContentAlignment="Center" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- 命令类型 -->
                <DataGridTemplateColumn Header="命令类型" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedIndex="{Binding CommandType, UpdateSourceTrigger=PropertyChanged}" 
                                      BorderThickness="0">
                                <ComboBoxItem Content="绝对运动"/>
                                <ComboBoxItem Content="相对运动"/>
                                <ComboBoxItem Content="停止"/>
                                <ComboBoxItem Content="急停"/>
                                <ComboBoxItem Content="设置参数"/>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- 目标位置/距离 -->
                <DataGridTemplateColumn Header="目标位置/距离" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding TargetPosition, UpdateSourceTrigger=PropertyChanged}" 
                                     VerticalContentAlignment="Center" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- 最大速度 -->
                <DataGridTemplateColumn Header="最大速度" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding MaxVelocity, UpdateSourceTrigger=PropertyChanged}" 
                                     VerticalContentAlignment="Center" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- 最大加速度 -->
                <DataGridTemplateColumn Header="最大加速度" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding MaxAccel, UpdateSourceTrigger=PropertyChanged}" 
                                     VerticalContentAlignment="Center" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- 最大减速度 -->
                <DataGridTemplateColumn Header="最大减速度" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding MaxDecel, UpdateSourceTrigger=PropertyChanged}" 
                                     VerticalContentAlignment="Center" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- 急停加速度 -->
                <DataGridTemplateColumn Header="急停加速度" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding EmergencyDecel, UpdateSourceTrigger=PropertyChanged}" 
                                     VerticalContentAlignment="Center" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- Jerk Time -->
                <DataGridTemplateColumn Header="Jerk Time(s)" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding JerkTime, UpdateSourceTrigger=PropertyChanged}" 
                                     VerticalContentAlignment="Center" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- 备注 -->
                <DataGridTemplateColumn Header="备注" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" 
                                     VerticalContentAlignment="Center" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部按钮 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="➕ 增加行" Width="100" Height="35" Margin="5" Click="BtnAddRow_Click"/>
                <Button Content="➖ 删除行" Width="100" Height="35" Margin="5" Click="BtnDeleteRow_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="加载预设" Width="100" Height="35" Margin="5" Click="BtnLoadPreset_Click"/>
                <Button Content="保存配置" Width="100" Height="35" Margin="5" Click="BtnSaveConfig_Click"/>
                <Button Content="加载配置" Width="100" Height="35" Margin="5" Click="BtnLoadConfig_Click"/>
                <Button Content="清空所有" Width="100" Height="35" Margin="5" Click="BtnClearAll_Click"/>
                <Button Content="确定" Width="100" Height="35" Margin="5" Click="BtnOK_Click" IsDefault="True"/>
                <Button Content="取消" Width="100" Height="35" Margin="5" Click="BtnCancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

