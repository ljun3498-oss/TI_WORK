<Window x:Class="MotionAPI_Test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="运动控制API测试工具 - S型曲线 Motion Control Test" Height="1000" Width="1600"
        Loaded="Window_Loaded" Closing="Window_Closing" WindowState="Maximized">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 控制面板 -->
        <GroupBox Header="控制面板" Grid.Row="0" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一行：轴使能和运动参数 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                    <Button x:Name="btnEnable" Content="使能轴" Width="100" Height="30" Margin="5" Click="BtnEnable_Click"/>
                    <Button x:Name="btnDisable" Content="禁用轴" Width="100" Height="30" Margin="5" Click="BtnDisable_Click"/>
                    <Separator Width="20" Background="Transparent"/>
                    
                    <!-- 曲线类型选择 -->
                    <Label Content="曲线类型:" VerticalAlignment="Center" FontWeight="Bold" Foreground="DarkBlue"/>
                    <ComboBox x:Name="cmbProfileType" Width="120" Height="25" SelectedIndex="0" SelectionChanged="CmbProfileType_SelectionChanged">
                        <ComboBoxItem Content="梯形曲线"/>
                        <ComboBoxItem Content="S型曲线"/>
                    </ComboBox>
                    <Separator Width="10" Background="Transparent"/>
                    
                    <!-- Jerk Time参数（仅S型曲线，单位：秒） -->
                    <Label x:Name="lblMaxJerk" Content="Jerk Time(s):" VerticalAlignment="Center" IsEnabled="False"/>
                    <TextBox x:Name="txtMaxJerk" Text="0.1" Width="80" Height="25" VerticalContentAlignment="Center" IsEnabled="False" TextChanged="TxtMaxJerk_TextChanged"/>
                    <Separator Width="20" Background="Transparent"/>
                    
                    <!-- 运动参数 -->
                    <Label Content="最大速度:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtMaxVel" Text="500" Width="80" Height="25" VerticalContentAlignment="Center"/>
                    <Label Content="最大加速度:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtMaxAccel" Text="2000" Width="80" Height="25" VerticalContentAlignment="Center"/>
                    <Label Content="最大减速度:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtMaxDecel" Text="2000" Width="80" Height="25" VerticalContentAlignment="Center"/>
                    <Button Content="设置参数" Width="100" Height="30" Margin="5" Click="BtnSetParams_Click"/>
                </StackPanel>

                <!-- 第二行：PID参数 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
                    <Label Content="位置环PID:" VerticalAlignment="Center" FontWeight="Bold"/>
                    <Label Content="Kp:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtKp" Text="10.0" Width="60" Height="25" VerticalContentAlignment="Center"/>
                    <Label Content="Ki:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtKi" Text="0.5" Width="60" Height="25" VerticalContentAlignment="Center"/>
                    <Label Content="Kd:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtKd" Text="0.1" Width="60" Height="25" VerticalContentAlignment="Center"/>
                    <Button Content="设置PID" Width="100" Height="30" Margin="5" Click="BtnSetPID_Click"/>
                </StackPanel>

                <!-- 第三行：运动命令 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5">
                    <Label Content="目标位置:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtTargetPos" Text="1000" Width="100" Height="25" VerticalContentAlignment="Center"/>
                    <Button x:Name="btnMoveAbs" Content="绝对运动" Width="100" Height="30" Margin="5" Click="BtnMoveAbs_Click"/>
                    <Button x:Name="btnMoveRel" Content="相对运动" Width="100" Height="30" Margin="5" Click="BtnMoveRel_Click"/>
                    <Button x:Name="btnStop" Content="停止" Width="100" Height="30" Margin="5" Click="BtnStop_Click" Background="Orange"/>
                    <Button x:Name="btnEStop" Content="急停" Width="100" Height="30" Margin="5" Click="BtnEStop_Click" Background="Red" Foreground="White"/>
                    <Separator Width="20" Background="Transparent"/>
                    
                    <!-- 命令序列 -->
                    <Button x:Name="btnConfigSequence" Content="📋 命令序列" Width="120" Height="30" Margin="5" Click="BtnConfigSequence_Click" Background="LightBlue" FontWeight="Bold"/>
                    <Button x:Name="btnStartSequence" Content="▶ 启动序列" Width="120" Height="30" Margin="5" Click="BtnStartSequence_Click" Background="LightGreen" FontWeight="Bold" IsEnabled="False"/>
                    <Button x:Name="btnStopSequence" Content="⏹ 停止序列" Width="120" Height="30" Margin="5" Click="BtnStopSequence_Click" Background="LightCoral" FontWeight="Bold" IsEnabled="False"/>
                    
                    <Separator Width="20" Background="Transparent"/>
                    <Label Content="仿真频率:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbSimFreq" Width="100" Height="25" SelectedIndex="2">
                        <ComboBoxItem Content="100 Hz"/>
                        <ComboBoxItem Content="500 Hz"/>
                        <ComboBoxItem Content="1000 Hz"/>
                        <ComboBoxItem Content="2000 Hz"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 图表和状态显示 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- 图表区域 -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- 左列：位置和速度 -->
                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                <!-- 位置曲线 -->
                    <GroupBox Header="位置曲线 (Position)" Grid.Column="0" Margin="0,0,5,0">
                    <oxy:PlotView x:Name="plotPosition" Model="{Binding PositionPlotModel}"/>
                </GroupBox>

                <!-- 速度曲线 -->
                    <GroupBox Header="速度曲线 (Velocity)" Grid.Column="1">
                    <oxy:PlotView x:Name="plotVelocity" Model="{Binding VelocityPlotModel}"/>
                </GroupBox>
                </Grid>
                
                <!-- 右列：加速度和加加速度 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                <!-- 加速度曲线 -->
                    <GroupBox Header="加速度曲线 (Acceleration)" Grid.Column="0" Margin="0,0,5,0">
                    <oxy:PlotView x:Name="plotAcceleration" Model="{Binding AccelerationPlotModel}"/>
                </GroupBox>
                    
                    <!-- 加加速度曲线 -->
                    <GroupBox Header="加加速度曲线 (Jerk) - S型曲线专用" Grid.Column="1">
                        <oxy:PlotView x:Name="plotJerk" Model="{Binding JerkPlotModel}"/>
                    </GroupBox>
                </Grid>
            </Grid>

            <!-- 状态显示区域 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="160"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <!-- 实时状态 -->
                <GroupBox Header="实时状态" Grid.Row="0" Margin="0,0,0,5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="5">
                            <!-- 曲线类型显示 -->
                            <TextBlock x:Name="txtProfileTypeDisplay" Text="曲线: 梯形曲线" FontWeight="Bold" Foreground="DarkBlue" Margin="0,0,0,5" FontSize="12"/>
                            <Separator Margin="0,3"/>
                            
                            <!-- 轴信息 -->
                            <TextBlock Text="【运动轴】" FontWeight="Bold" Foreground="DarkBlue" Margin="0,0,0,3"/>
                            <TextBlock x:Name="txtAxisState" Text="轴状态: Disabled" Margin="2,0,2,2" FontSize="10"/>
                            <TextBlock x:Name="txtMotorCount" Text="电机数量: 0" Margin="2,0,2,2" FontSize="10"/>
                            <Separator Margin="0,3"/>

                            <!-- 运动目标 -->
                            <TextBlock Text="【运动目标】" FontWeight="Bold" Foreground="DarkOrange" Margin="0,3,0,3"/>
                            <TextBlock x:Name="txtTargetPosDisplay" Text="目标位置: 0.000" Margin="2,0,2,2" FontSize="10" Foreground="DarkOrange"/>
                            <Separator Margin="0,3"/>

                            <!-- 轴位置数据 -->
                            <TextBlock Text="【轴位置】" FontWeight="Bold" Foreground="DarkGreen" Margin="0,3,0,3"/>
                            <TextBlock x:Name="txtAxisCmdPos" Text="命令: 0.000" Margin="2,0,2,2" FontSize="10" Foreground="Blue"/>
                            <TextBlock x:Name="txtAxisActPos" Text="实际: 0.000" Margin="2,0,2,2" FontSize="10" Foreground="Red"/>
                            <Separator Margin="0,3"/>

                            <!-- 轴速度数据 -->
                            <TextBlock Text="【轴速度】" FontWeight="Bold" Foreground="DarkGreen" Margin="0,3,0,3"/>
                            <TextBlock x:Name="txtAxisCmdVel" Text="命令: 0.00" Margin="2,0,2,2" FontSize="10" Foreground="Blue"/>
                            <Separator Margin="0,3"/>

                            <!-- 轴加速度 -->
                            <TextBlock Text="【加速度/加加速度】" FontWeight="Bold" Foreground="DarkGreen" Margin="0,3,0,3"/>
                            <TextBlock x:Name="txtAxisAccel" Text="加速度: 0.0" Margin="2,0,2,2" FontSize="10" Foreground="Orange"/>
                            <TextBlock x:Name="txtAxisJerk" Text="加加速度: 0.0" Margin="2,0,2,2" FontSize="10" Foreground="Purple"/>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

                <!-- 缓冲区监视 -->
                <GroupBox Header="位置缓冲区" Grid.Row="1" Margin="0,0,0,5">
                    <StackPanel Margin="5">
                        <TextBlock x:Name="txtBufferCount" Text="缓冲数量: 0 / 128" Margin="2"/>
                        <ProgressBar x:Name="progressBuffer" Height="20" Margin="2" Maximum="128" Value="0"/>
                        <TextBlock x:Name="txtBufferOverflow" Text="溢出次数: 0" Margin="2" Foreground="Red"/>
                        <TextBlock x:Name="txtBufferUnderflow" Text="欠载次数: 0" Margin="2" Foreground="Orange"/>
                        <TextBlock x:Name="txtProfileState" Text="轨迹状态: Idle" Margin="2"/>
                    </StackPanel>
                </GroupBox>

                <!-- 日志 -->
                <GroupBox Header="运行日志" Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="txtLog" IsReadOnly="True" TextWrapping="Wrap" 
                                 VerticalScrollBarVisibility="Auto" Background="Black" 
                                 Foreground="LightGreen" FontFamily="Consolas" FontSize="10"/>
                    </ScrollViewer>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <StatusBar Grid.Row="2" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="txtStatusBar" Text="就绪"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="txtSimTime" Text="仿真时间: 0.000 s"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="txtUpdateRate" Text="更新率: 0 Hz"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

