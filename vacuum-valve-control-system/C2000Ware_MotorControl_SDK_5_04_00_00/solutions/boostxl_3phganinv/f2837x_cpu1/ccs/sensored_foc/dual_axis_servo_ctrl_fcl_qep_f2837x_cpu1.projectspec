<projectSpec>
  <project
        name="dual_axis_servo_ctrl_fcl_qep_f2837x_cpu1"
        device="Generic C28xx Device"
        cgtVersion="20.2.2.LTS"
        outputFormat="ELF"
        launchWizard="False"
        linkerCommandFile=""
        sourceLookupPath="${C2000WARE_DLIB_ROOT}"
        >

    <configuration
        name="F2837x_RAM"
        compilerBuildOptions="-v28 -ml -mt --float_support=fpu32 --tmu_support=tmu0 -O4 --opt_for_speed=5 --fp_mode=relaxed
			-I${C2000WARE_DEVICE_SUPPORT_ROOT}/common/include/
			-I${C2000WARE_DEVICE_SUPPORT_ROOT}/headers/include/
			-I${C2000WARE_DLIB_ROOT}			   
 		    -I${C2000WARE_LIB_ROOT}/math/FPUfastRTS/c28/include/ 				
			-I${C2000WARE_LIB_ROOT}/control/DCL/c28/include/                     
			-I${SFRA_INSTALL_ROOT}/include/
			-I${SFRA_INSTALL_ROOT}/gui/include/
			-I${SDK_ROOT}/libraries/utilities/datalog/include/
            -I${SDK_ROOT}/libraries/fcl/include/
			-I${SDK_ROOT}/libraries/utilities/math_blocks/include/v4.3/
			-I${SDK_ROOT}/solutions/common/sensored_foc/include/
			-I${SDK_ROOT}/solutions/boostxl_3phganinv/f2837x_cpu1/include/
			--define=_DEBUG --define=LARGE_MODEL --define=CPU1 
            --define=_DUAL_HEADERS --define=_STANDALONE --define=TEST_ENABLE 
            --define=F2837x_DEVICE --define=_LAUNCHXL_F28379D --define=_BOOSTXL_3PHGANINV 
			-g --diag_warning=225 --diag_suppress=10063 
            --quiet -k --asm_listing 
            --gen_func_subsections=on --abi=eabi"
        linkerBuildOptions="--entry_point code_start --stack_size=0x380 			
			--reread_libs
			-llibc.a"
        />
    <configuration
        name="F2837x_FLASH"
        compilerBuildOptions="-v28 -ml -mt --float_support=fpu32 --tmu_support=tmu0 -O4 --opt_for_speed=5 --fp_mode=relaxed
			-I${C2000WARE_DEVICE_SUPPORT_ROOT}/common/include/
			-I${C2000WARE_DEVICE_SUPPORT_ROOT}/headers/include/
			-I${C2000WARE_DLIB_ROOT}             
            -I${C2000WARE_LIB_ROOT}/math/FPUfastRTS/c28/include/ 				
			-I${C2000WARE_LIB_ROOT}/control/DCL/c28/include/
			-I${SFRA_INSTALL_ROOT}/include/
			-I${SFRA_INSTALL_ROOT}/gui/include/
			-I${SDK_ROOT}/libraries/utilities/datalog/include/
            -I${SDK_ROOT}/libraries/fcl/include/
			-I${SDK_ROOT}/libraries/utilities/math_blocks/include/v4.3/
			-I${SDK_ROOT}/solutions/common/sensored_foc/include/
			-I${SDK_ROOT}/solutions/boostxl_3phganinv/f2837x_cpu1/include/
			--define=_DEBUG --define=LARGE_MODEL --define=_FLASH --define=CPU1 
            --define=_DUAL_HEADERS --define=_STANDALONE --define=TEST_ENABLE  
            --define=F2837x_DEVICE --define=_LAUNCHXL_F28379D --define=_BOOSTXL_3PHGANINV
			-g --diag_warning=225 --diag_suppress=10063 
            --quiet -k --asm_listing 
            --gen_func_subsections=on --abi=eabi"
        linkerBuildOptions="--entry_point code_start --stack_size=0x380 			
			--reread_libs 
            -llibc.a"
        />

    <pathVariable name="C2000WARE_DEVICE_SUPPORT_ROOT" path="../../../../../c2000ware/device_support/f2837xd" scope="project" />
    <pathVariable name="C2000WARE_DLIB_ROOT" path="../../../../../c2000ware/driverlib/f2837xd/driverlib" scope="project" />
    <pathVariable name="C2000WARE_LIB_ROOT" path="../../../../../c2000ware/libraries" scope="project" />
    <pathVariable name="SFRA_INSTALL_ROOT" path="../../../../../libraries/sfra" scope="project" />
    <pathVariable name="SDK_ROOT" path="../../../../.." scope="project" />


    <file action="link" path="SFRA_INSTALL_ROOT/lib/sfra.lib" targetDirectory="" />

    <file action="link" path="SDK_ROOT/solutions/common/sensored_foc/debug/dual_axis_servo_drive_vars.txt" targetDirectory="" />
    <file action="link" path="SDK_ROOT/solutions/common/sensored_foc/debug/dual_axis_servo_drive_graph1.graphProp" targetDirectory="" />
    <file action="link" path="SDK_ROOT/solutions/common/sensored_foc/debug/dual_axis_servo_drive_graph2.graphProp" targetDirectory="" />

    <file action="link" path="SDK_ROOT/solutions/boostxl_3phganinv/f2837x_cpu1/cmd/dual_axis_f2837x_flash_lnk_cpu1.cmd" targetDirectory="src_device" applicableConfigurations="F2837x_FLASH" />
    <file action="link" path="SDK_ROOT/solutions/boostxl_3phganinv/f2837x_cpu1/cmd/dual_axis_f2837x_ram_lnk_cpu1.cmd" targetDirectory="src_device" applicableConfigurations="F2837x_RAM" />
    <file action="link" path="SDK_ROOT/solutions/boostxl_3phganinv/f2837x/cmd/F2837xD_Headers_nonBIOS_cpu1_eabi.cmd" targetDirectory="src_device" />

    <file action="link" path="C2000WARE_DEVICE_SUPPORT_ROOT/common/targetConfigs/TMS320F28379D.ccxml" targetDirectory="" />
    <file action="link" path="C2000WARE_DEVICE_SUPPORT_ROOT/common/source/device.c" targetDirectory="src_device" />
    <file action="copy" path="C2000WARE_DEVICE_SUPPORT_ROOT/headers/source/F2837xD_GlobalVariableDefs.c" targetDirectory="src_device" />
    <file action="link" path="C2000WARE_DEVICE_SUPPORT_ROOT/common/source/F2837xD_CodeStartBranch.asm" targetDirectory="src_device" />	

    <file action="link" path="C2000WARE_DLIB_ROOT/ccs/Release/driverlib.lib" targetDirectory="" />

    <file action="copy" path="C2000WARE_DLIB_ROOT/cputimer.c" targetDirectory="src_driver" applicableConfigurations="" />
    <file action="copy" path="C2000WARE_DLIB_ROOT/gpio.c" targetDirectory="src_driver" applicableConfigurations="" />
    <file action="copy" path="C2000WARE_DLIB_ROOT/interrupt.c" targetDirectory="src_driver" applicableConfigurations="" />
    <file action="copy" path="C2000WARE_DLIB_ROOT/memcfg.c" targetDirectory="src_driver" applicableConfigurations="" />
    <file action="copy" path="C2000WARE_DLIB_ROOT/sci.c" targetDirectory="src_driver" applicableConfigurations="" />
    <file action="copy" path="C2000WARE_DLIB_ROOT/sysctl.c" targetDirectory="src_driver" applicableConfigurations="" />
    <file action="copy" path="C2000WARE_DLIB_ROOT/ipc.c" targetDirectory="src_driver" applicableConfigurations="" />
    <file action="copy" path="C2000WARE_DLIB_ROOT/dac.c" targetDirectory="src_driver" applicableConfigurations="" />

    <file action="copy" path="SFRA_INSTALL_ROOT/gui/source/sfra_gui_scicomms_driverlib.c" targetDirectory="sources" />

    <file action="copy" path="SDK_ROOT/libraries/utilities/datalog/source/dlog_4ch_f.c" targetDirectory="sources" />

    <file action="copy" path="SDK_ROOT/solutions/common/sensored_foc/source/sfra_gui.c" targetDirectory="sources" />
    
    <!-- CPU1 specific source files -->
    <file action="copy" path="SDK_ROOT/solutions/boostxl_3phganinv/f2837x_cpu1/source/dual_axis_servo_ctrl_main_cpu1.c" targetDirectory="sources" />
    <file action="copy" path="SDK_ROOT/solutions/boostxl_3phganinv/f2837x_cpu1/source/dual_axis_servo_ctrl_cpu1.c" targetDirectory="sources" />
    <file action="copy" path="SDK_ROOT/solutions/boostxl_3phganinv/f2837x_cpu1/source/dual_axis_servo_ctrl_user_cpu1.c" targetDirectory="sources" />

    <!-- CPU1 HAL files -->
    <file action="copy" path="SDK_ROOT/solutions/boostxl_3phganinv/f2837x_cpu1/include/dual_axis_servo_ctrl_hal_cpu1.h" targetDirectory="headers" />
    <file action="copy" path="SDK_ROOT/solutions/boostxl_3phganinv/f2837x_cpu1/include/dual_axis_servo_drive_settings.h" targetDirectory="headers" />
    <file action="copy" path="SDK_ROOT/solutions/boostxl_3phganinv/f2837x_cpu1/include/dual_axis_servo_drive_user.h" targetDirectory="headers" />
    <file action="copy" path="SDK_ROOT/solutions/boostxl_3phganinv/f2837x_cpu1/include/dual_axis_servo_drive_ipc.h" targetDirectory="headers" />
    <file action="copy" path="SDK_ROOT/solutions/boostxl_3phganinv/f2837x_cpu1/include/sfra_settings.h" targetDirectory="headers" />
    
    <!-- Motion Control Library files (for FCL_LEVEL7 and above) -->
    <file action="copy" path="SDK_ROOT/solutions/boostxl_3phganinv/f2837x_cpu1/include/motion_control.h" targetDirectory="headers" />
    
    <file action="copy" path="SDK_ROOT/solutions/boostxl_3phganinv/f2837x_cpu1/source/dual_axis_servo_ctrl_hal_cpu1.c" targetDirectory="sources" />
    <file action="copy" path="SDK_ROOT/solutions/boostxl_3phganinv/f2837x_cpu1/source/motion_control.c" targetDirectory="sources" />

  </project>
</projectSpec>

